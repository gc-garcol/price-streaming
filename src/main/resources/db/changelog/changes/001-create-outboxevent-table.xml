<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!--
        Native PostgreSQL DDL rather than Liquibase's abstracted change types.
        This pins the exact types emitted (jsonb, identity) at the cost of
        portability: these changesets only run against PostgreSQL.
    -->
    <changeSet id="001-create-outboxevent-table" author="garcol">
        <comment>Debezium outbox table; CDC source for the price stream.</comment>

        <sql dbms="postgresql" splitStatements="false">
            CREATE TABLE outboxevent (
                id            bigint                 GENERATED BY DEFAULT AS IDENTITY,
                event_id      uuid                   NOT NULL,
                aggregatetype character varying(255) NOT NULL,
                aggregateid   character varying(255) NOT NULL,
                type          character varying(255) NOT NULL,
                payload       jsonb,
                CONSTRAINT pk_outboxevent PRIMARY KEY (id),
                CONSTRAINT uq_outboxevent_event_id UNIQUE (event_id)
            )
        </sql>

        <rollback>
            <sql dbms="postgresql" splitStatements="false">
                DROP TABLE outboxevent
            </sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
